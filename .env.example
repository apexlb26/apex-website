# ---------------------------------------------------------------- database
# MongoDB holds everything the CMS can change: page copy, labels, images
# (base64), products, blog posts, career roles, drafts, publish history and
# form submissions.
#
# Local development falls back to mongodb://127.0.0.1:27017 when this is unset.
# Production requires it.
MONGODB_URI=
MONGODB_DB=apex

# ------------------------------------------------------------------- admin
# Required in production for /admin authentication.
APEX_ADMIN_EMAIL=admin@example.com
APEX_ADMIN_PASSWORD=replace-with-a-strong-password
APEX_ADMIN_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional; same-origin preview is used if omitted.
NEXT_PUBLIC_APEX_SITE_URL=

# ---------------------------------------------------------------- realtime
# The port the custom Node server (server.mjs) listens on. Socket.IO needs a
# process that stays alive; on serverless hosts clients poll instead.
PORT=3000

# -------------------------------------------------------------------- mail
# Where career applications and contact enquiries are emailed. Submissions are
# stored in MongoDB either way, so a mail outage no longer loses them.
APEX_NOTIFY_EMAIL=admin@apexlb.tech
APEX_MAIL_FROM=APEX Website <admin@apexlb.tech>

# Mail transport - set EITHER the SMTP group OR a Resend key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_URL=smtps://user:pass@mail.example.com:465
RESEND_API_KEY=
