# Required on Vercel for /admin authentication
APEX_ADMIN_EMAIL=admin@example.com
APEX_ADMIN_PASSWORD=replace-with-a-strong-password
APEX_ADMIN_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional; same-origin preview is used if omitted.
NEXT_PUBLIC_APEX_SITE_URL=

# Required on Vercel if Publish should commit CMS content back to this website repo.
GITHUB_TOKEN=
GITHUB_REPO=Ex3Cut1On3r/apex-test-website
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH_EN=shared/en.json
GITHUB_CONTENT_PATH_AR=shared/ar.json
GITHUB_MEDIA_PATH=public/uploads

# Realtime: the port the custom Node server (server.mjs) listens on.
PORT=3000

# Where career applications and contact enquiries are emailed.
APEX_NOTIFY_EMAIL=admin@apexlb.tech
APEX_MAIL_FROM=APEX Website <admin@apexlb.tech>

# Mail transport - set EITHER the SMTP group OR a Resend key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_URL=smtps://user:pass@mail.example.com:465
RESEND_API_KEY=
