# ---------------------------------------------------------------- database
# MongoDB holds CMS content, media, submissions, revisions and protected
# server-side settings.
MONGODB_URI=
MONGODB_DB=apex

# ------------------------------------------------------------------- admin
# Required in production for /admin authentication and for protecting CMS mail
# credentials. APEX_MAIL_SETTINGS_KEY may be used instead of APEX_ADMIN_SECRET
# specifically for encrypting the SMTP password stored in CMS.
APEX_ADMIN_EMAIL=admin@example.com
APEX_ADMIN_PASSWORD=replace-with-a-strong-password
APEX_ADMIN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# APEX_MAIL_SETTINGS_KEY=replace-with-a-separate-long-random-secret

NEXT_PUBLIC_APEX_SITE_URL=

# ---------------------------------------------------------------- realtime
PORT=3000

# -------------------------------------------------------------------- mail
# Environment values are the fallback. Protected CMS mail settings, when saved,
# override these values field-by-field.
#
# Notification recipients may be comma-separated. If omitted, the SMTP user/from
# address is used as the final fallback recipient.
APEX_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional alternatives / backwards compatibility:
# SMTP_URL=smtps://user:password@mail.example.com:465
# APEX_MAIL_FROM=APEX Website <website@example.com>
# RESEND_API_KEY=
